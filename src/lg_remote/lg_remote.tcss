Screen {
    background: $background;
    color: $text;
}

Header {
    background: $panel;
    color: $text;
}

#status-bar {
    dock: top;
    height: 3;
    padding: 0 2;
    background: $boost;
    border: round $primary;
    content-align: left middle;
    text-style: bold;
}

#status-bar.-connected {
    border: round $success;
}

#status-bar.-disconnected {
    border: round $error;
}

.section-title {
    color: $text-muted;
    text-style: bold;
    padding: 1 0 0 1;
}

.help-text {
    color: $text-muted;
    padding: 0 1;
}

.error-text {
    color: $error;
    text-style: bold;
    padding: 0 1;
}

#setup-message, #current-ip {
    padding: 0 1;
}

#top-row, #quick-apps-row {
    layout: horizontal;
    height: 5;
    align: center middle;
    padding: 0 1;
    border: round $primary-darken-1;
    background: $surface;
}

#top-row Button, #quick-apps-row Button {
    width: 1fr;
    height: 3;
    margin: 0 1;
    border: round $primary;
    text-style: bold;
}

#top-row Button:hover, #quick-apps-row Button:hover {
    border: round $accent;
}

#dpad {
    align: center middle;
    height: auto;
    padding: 0 1;
    border: round $primary-darken-1;
    background: $surface;
}

#dpad Button {
    border: round $primary;
    min-width: 7;
    margin: 0 1;
    text-style: bold;
}

#dpad Button:hover {
    border: round $accent;
}

#dpad #dpad-ok {
    min-width: 9;
    text-style: bold;
}

#dpad Horizontal {
    align: center middle;
    height: 3;
}

#vol-channel-row {
    layout: horizontal;
    height: 9;
    padding: 1 2;
    background: $surface;
}

#vol-channel-row Vertical {
    width: 1fr;
    align: center middle;
    border: round $secondary;
    margin: 0 1;
}

#vol-channel-row Button {
    width: 100%;
    height: 3;
}

#vol-channel-row Button:hover {
    border: round $accent;
}

#setup-form, #service-form, #settings-form, #confirm-box {
    padding: 1 2;
    border: round $primary;
    background: $surface;
    margin: 1 2;
}

#setup-title, #settings-title {
    text-style: bold;
    padding: 0 0 1 0;
}

#ip-input {
    width: 40;
    margin: 1 0;
}

.danger-zone {
    border: round $error;
    background: $surface;
    padding: 1 2;
    margin: 1 0;
}

.danger-zone Button {
    background: $error;
    margin: 0 1 1 0;
}

#log-panel {
    height: 8;
    border: round $secondary;
    background: $surface;
    padding: 1;
    overflow-y: auto;
}

#confirm-box {
    align: center middle;
}

#confirm-box Horizontal {
    align: center middle;
    height: auto;
    padding: 1 0 0 0;
}

#confirm-box Button {
    margin: 0 1;
}
